# Flint 3D Model Generation Server Configuration

# Claude API Settings
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1024
CLAUDE_TEMPERATURE=0.7
CLAUDE_MAX_STEPS=10

# Server Settings  
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD_ON_CHANGE=true

# Rate Limiting
MAX_PROMPT_LENGTH=200
REQUEST_TIMEOUT=120

# File Paths (will be overridden by absolute paths in code)
EXPORT_FOLDER_NAME=exports
BLEND_FILENAME=scene.blend
EXPORT_FILENAME=exported_model.usdz

# Blender Settings
BLENDER_TIMEOUT=120
BLEND_FILE_MIN_SIZE=1024